<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.ClaudeEssential" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Primary -->
        <item name="colorPrimary">@color/category_essential</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">#004785</item>
        <item name="colorOnPrimaryContainer">#D6E4FF</item>

        <!-- Secondary -->
        <item name="colorSecondary">#BBC7DB</item>
        <item name="colorOnSecondary">#263141</item>
        <item name="colorSecondaryContainer">#3C4858</item>
        <item name="colorOnSecondaryContainer">#D7E3F8</item>

        <!-- Tertiary -->
        <item name="colorTertiary">#D7BDE4</item>
        <item name="colorOnTertiary">#3B2948</item>
        <item name="colorTertiaryContainer">#534060</item>
        <item name="colorOnTertiaryContainer">#F3DAFF</item>

        <!-- Error -->
        <item name="colorError">#FFB4AB</item>
        <item name="colorOnError">#690005</item>
        <item name="colorErrorContainer">#93000A</item>
        <item name="colorOnErrorContainer">#FFDAD6</item>

        <!-- Surface & Background — critical for consistent dark mode look -->
        <item name="colorSurface">@color/background_light</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">#43474E</item>
        <item name="colorOnSurfaceVariant">#C3C6CF</item>
        <item name="colorSurfaceContainerLowest">#0E0E0E</item>
        <item name="colorSurfaceContainerLow">#1A1A1A</item>
        <item name="colorSurfaceContainer">@color/card_background</item>
        <item name="colorSurfaceContainerHigh">#2A2A2C</item>
        <item name="colorSurfaceContainerHighest">#353537</item>

        <!-- Outline -->
        <item name="colorOutline">#8D9199</item>
        <item name="colorOutlineVariant">#43474E</item>

        <!-- System bars -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">@color/background_light</item>
        <item name="android:windowTranslucentNavigation">false</item>

        <!-- Disable M3 elevation tinting — prevents unwanted purple-ish overlay on dark surfaces -->
        <item name="elevationOverlayEnabled">false</item>
    </style>
</resources>
