<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="28dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@color/card_background"
    tools:context=".ColorPickerActivity">

    <com.essential.shortcuts.ObservableScrollView
        android:layout_width="match_parent"
        android:layout_height="600dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Color Picker"
                android:textColor="@color/text_primary"
                android:textSize="24sp"
                android:textStyle="bold"
                android:gravity="center_horizontal"
                android:layout_marginBottom="16dp"/>

            <!-- Color Swatch -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="120dp"
                app:cardCornerRadius="16dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/calc_divider"
                android:layout_marginBottom="16dp">
                <View
                    android:id="@+id/view_color_swatch"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#000000" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Hex Input -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:boxCornerRadiusTopStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusBottomEnd="12dp">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_hex_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="HEX Code (e.g. #FF0000)"
                    android:inputType="textCapCharacters"
                    android:lines="1"
                    android:maxLines="1"/>
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RGB Sliders"
                android:textColor="@color/text_secondary"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <!-- Red Slider -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:text="R"
                    android:textColor="#FF5252"
                    android:textStyle="bold"
                    android:textSize="16sp"/>

                <SeekBar
                    android:id="@+id/seek_red"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="255"
                    android:progress="0"
                    android:progressTint="#FF5252"
                    android:thumbTint="#FF5252"/>

                <TextView
                    android:id="@+id/tv_red_val"
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:gravity="end"
                    android:textColor="@color/text_primary"/>
            </LinearLayout>

            <!-- Green Slider -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:text="G"
                    android:textColor="#4CAF50"
                    android:textStyle="bold"
                    android:textSize="16sp"/>

                <SeekBar
                    android:id="@+id/seek_green"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="255"
                    android:progress="0"
                    android:progressTint="#4CAF50"
                    android:thumbTint="#4CAF50"/>

                <TextView
                    android:id="@+id/tv_green_val"
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:gravity="end"
                    android:textColor="@color/text_primary"/>
            </LinearLayout>

            <!-- Blue Slider -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:text="B"
                    android:textColor="#2196F3"
                    android:textStyle="bold"
                    android:textSize="16sp"/>

                <SeekBar
                    android:id="@+id/seek_blue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="255"
                    android:progress="0"
                    android:progressTint="#2196F3"
                    android:thumbTint="#2196F3"/>

                <TextView
                    android:id="@+id/tv_blue_val"
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:gravity="end"
                    android:textColor="@color/text_primary"/>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HSV Sliders"
                android:textColor="@color/text_secondary"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <!-- Hue Slider -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:text="H"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold"
                    android:textSize="16sp"/>

                <SeekBar
                    android:id="@+id/seek_hue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="360"
                    android:progress="0"
                    android:progressTint="@color/text_secondary"
                    android:thumbTint="@color/text_primary"/>

                <TextView
                    android:id="@+id/tv_hue_val"
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:text="0°"
                    android:gravity="end"
                    android:textColor="@color/text_primary"/>
            </LinearLayout>

            <!-- Saturation Slider -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:text="S"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold"
                    android:textSize="16sp"/>

                <SeekBar
                    android:id="@+id/seek_sat"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="0"
                    android:progressTint="@color/text_secondary"
                    android:thumbTint="@color/text_primary"/>

                <TextView
                    android:id="@+id/tv_sat_val"
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:text="0%"
                    android:gravity="end"
                    android:textColor="@color/text_primary"/>
            </LinearLayout>

            <!-- Value Slider -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:text="V"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold"
                    android:textSize="16sp"/>

                <SeekBar
                    android:id="@+id/seek_val"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="0"
                    android:progressTint="@color/text_secondary"
                    android:thumbTint="@color/text_primary"/>

                <TextView
                    android:id="@+id/tv_val_val"
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:text="0%"
                    android:gravity="end"
                    android:textColor="@color/text_primary"/>
            </LinearLayout>

            <!-- Output Results -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <!-- HEX Result -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="HEX Color"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary"/>

                    <TextView
                        android:id="@+id/tv_hex_code"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="#000000"
                        android:textSize="18sp"
                        android:fontFamily="monospace"
                        android:textColor="@color/text_primary"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="8dp"/>

                    <Button
                        android:id="@+id/btn_copy_hex"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Copy HEX"
                        android:textColor="@color/text_primary"
                        app:strokeColor="@color/text_secondary"
                        android:layout_marginEnd="8dp"/>
                </LinearLayout>

                <!-- RGB Result -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="RGB Color"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary"/>

                    <TextView
                        android:id="@+id/tv_rgb_code"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="rgb(0, 0, 0)"
                        android:textSize="18sp"
                        android:fontFamily="monospace"
                        android:textColor="@color/text_primary"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="8dp"/>

                    <Button
                        android:id="@+id/btn_copy_rgb"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Copy RGB"
                        android:textColor="@color/text_primary"
                        app:strokeColor="@color/text_secondary"
                        android:layout_marginStart="8dp"/>
                </LinearLayout>
            </LinearLayout>

            <Button
                android:id="@+id/btn_close"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:text="Close"
                android:textColor="@color/text_secondary"/>

        </LinearLayout>
    </com.essential.shortcuts.ObservableScrollView>
</androidx.cardview.widget.CardView>
