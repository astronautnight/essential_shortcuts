<?xml version="1.0" encoding="utf-8"?>
<com.essential.shortcuts.ObservableScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    tools:context=".ImageColorPickerActivity">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="28dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/card_background">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Image Color Picker"
                    android:textSize="22sp"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btn_close"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    app:tint="@color/text_secondary"
                    android:contentDescription="Close"/>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tap or drag on the image to pick a color."
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:layout_marginBottom="12dp"/>

            <!-- Pick Image Area -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_pick_image"
                android:layout_width="match_parent"
                android:layout_height="280dp"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="@color/pwd_result_bg"
                app:strokeWidth="1dp"
                app:strokeColor="@color/text_secondary"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:id="@+id/layout_pick_placeholder"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">
                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@android:drawable/ic_menu_gallery"
                        app:tint="@color/text_secondary"
                        android:contentDescription="Pick image"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tap to select an image"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp"
                        android:layout_marginTop="8dp"/>
                </LinearLayout>

                <ImageView
                    android:id="@+id/iv_preview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter"
                    android:adjustViewBounds="true"
                    android:visibility="gone"
                    android:contentDescription="Image preview"/>
            </com.google.android.material.card.MaterialCardView>

            <Button
                android:id="@+id/btn_change_image"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Change Image"
                android:layout_gravity="center_horizontal"
                android:textColor="@color/text_primary"
                app:strokeColor="@color/text_secondary"
                android:layout_marginBottom="24dp"
                android:visibility="gone"/>

            <!-- Result Section -->
            <LinearLayout
                android:id="@+id/layout_result"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Color Swatch -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp"
                    android:layout_marginBottom="20dp">
                    <View
                        android:id="@+id/view_color_swatch"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#000000"/>
                </com.google.android.material.card.MaterialCardView>

                <!-- HEX Output -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">
                    
                    <TextView
                        android:layout_width="60dp"
                        android:layout_height="wrap_content"
                        android:text="HEX"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/tv_hex_code"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="#000000"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:fontFamily="monospace"/>

                    <ImageButton
                        android:id="@+id/btn_copy_hex"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@android:drawable/ic_menu_edit"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        app:tint="@color/text_secondary"
                        android:contentDescription="Copy HEX"/>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/calc_divider"
                    android:layout_marginBottom="12dp"/>

                <!-- RGB Output -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="60dp"
                        android:layout_height="wrap_content"
                        android:text="RGB"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/tv_rgb_code"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="rgb(0, 0, 0)"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:fontFamily="monospace"/>

                    <ImageButton
                        android:id="@+id/btn_copy_rgb"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@android:drawable/ic_menu_edit"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        app:tint="@color/text_secondary"
                        android:contentDescription="Copy RGB"/>
                </LinearLayout>
                
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</com.essential.shortcuts.ObservableScrollView>
