<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:id="@+id/dialog_card_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_gravity="top|center_horizontal">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/share_dialog_bg"
            app:strokeWidth="0dp"
            android:layout_margin="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Subtitle/Question outside the inner card -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="What do you want to do?"
                    android:textSize="20sp"
                    android:textColor="@color/share_dialog_text"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="12dp"
                    android:layout_marginStart="4dp" />

                <!-- Inner card containing options -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/share_dialog_inner_bg"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:id="@+id/options_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp">

                        <!-- Row 1: Resize Image -->
                        <TextView
                            android:id="@+id/card_resize"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Resize Image"
                            android:textColor="@color/share_dialog_text"
                            android:textSize="17sp"
                            android:paddingTop="16dp"
                            android:paddingBottom="16dp"
                            android:background="?android:attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="0.5dp"
                            android:background="@color/share_dialog_divider" />

                        <!-- Row 2: Rounded Image -->
                        <TextView
                            android:id="@+id/card_rounded"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Rounded Image"
                            android:textColor="@color/share_dialog_text"
                            android:textSize="17sp"
                            android:paddingTop="16dp"
                            android:paddingBottom="16dp"
                            android:background="?android:attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="0.5dp"
                            android:background="@color/share_dialog_divider" />

                        <!-- Row 3: Compress Image -->
                        <TextView
                            android:id="@+id/card_compress"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Compress Image"
                            android:textColor="@color/share_dialog_text"
                            android:textSize="17sp"
                            android:paddingTop="16dp"
                            android:paddingBottom="16dp"
                            android:background="?android:attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="0.5dp"
                            android:background="@color/share_dialog_divider" />

                        <!-- Row 4: Pixel Frames -->
                        <TextView
                            android:id="@+id/card_pixel_frame"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Pixel Frames"
                            android:textColor="@color/share_dialog_text"
                            android:textSize="17sp"
                            android:paddingTop="16dp"
                            android:paddingBottom="16dp"
                            android:background="?android:attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="0.5dp"
                            android:background="@color/share_dialog_divider" />

                        <!-- Row 4b: Laptop Frames -->
                        <TextView
                            android:id="@+id/card_laptop_frame"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Laptop Frames"
                            android:textColor="@color/share_dialog_text"
                            android:textSize="17sp"
                            android:paddingTop="16dp"
                            android:paddingBottom="16dp"
                            android:background="?android:attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="0.5dp"
                            android:background="@color/share_dialog_divider" />

                        <!-- Row 4c: Meme Generator -->
                        <TextView
                            android:id="@+id/card_meme"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Generate a Meme"
                            android:textColor="@color/share_dialog_text"
                            android:textSize="17sp"
                            android:paddingTop="16dp"
                            android:paddingBottom="16dp"
                            android:background="?android:attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="0.5dp"
                            android:background="@color/share_dialog_divider" />

                        <!-- Row 5: Convert Image -->
                        <TextView
                            android:id="@+id/card_convert_image"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Convert Image"
                            android:textColor="@color/share_dialog_text"
                            android:textSize="17sp"
                            android:paddingTop="16dp"
                            android:paddingBottom="16dp"
                            android:background="?android:attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true" />

                        <View
                            android:id="@+id/divider_convert_image"
                            android:layout_width="match_parent"
                            android:layout_height="0.5dp"
                            android:background="@color/share_dialog_divider" />

                        <!-- Row 6: Convert to Word (PDF -> Word) -->
                        <TextView
                            android:id="@+id/card_pdf_to_word"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Convert to Word"
                            android:textColor="@color/share_dialog_text"
                            android:textSize="17sp"
                            android:paddingTop="16dp"
                            android:paddingBottom="16dp"
                            android:background="?android:attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true" />

                        <View
                            android:id="@+id/divider_pdf_to_word"
                            android:layout_width="match_parent"
                            android:layout_height="0.5dp"
                            android:background="@color/share_dialog_divider" />

                        <!-- Row 7: Combine PDFs -->
                        <TextView
                            android:id="@+id/card_pdf_combine"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Combine PDFs"
                            android:textColor="@color/share_dialog_text"
                            android:textSize="17sp"
                            android:paddingTop="16dp"
                            android:paddingBottom="16dp"
                            android:background="?android:attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true" />

                        <View
                            android:id="@+id/divider_word_to_pdf"
                            android:layout_width="match_parent"
                            android:layout_height="0.5dp"
                            android:background="@color/share_dialog_divider" />

                        <!-- Row 8: Convert to PDF (Word -> PDF) -->
                        <TextView
                            android:id="@+id/card_word_to_pdf"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Convert to PDF"
                            android:textColor="@color/share_dialog_text"
                            android:textSize="17sp"
                            android:paddingTop="16dp"
                            android:paddingBottom="16dp"
                            android:background="?android:attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </ScrollView>

    <!-- Dynamic Island Pill Container -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/dynamic_island_pill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="0dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="#2AFFFFFF"
        app:cardBackgroundColor="#121212"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <!-- Tool Icon on the Left -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="28dp"
                android:layout_height="28dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#1F1F1F"
                app:strokeWidth="0dp">

                <ImageView
                    android:id="@+id/pill_tool_icon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="5dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_launcher_foreground" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Close Button in the Center -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/pill_close_btn"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="16dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#1F1F1F"
                app:strokeWidth="0dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_close"
                    android:padding="6dp"
                    app:tint="@color/white" />
            </com.google.android.material.card.MaterialCardView>

            <!-- ProgressTickView on the Right -->
            <com.essential.shortcuts.ProgressTickView
                android:id="@+id/progress_tick"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="16dp" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</FrameLayout>
