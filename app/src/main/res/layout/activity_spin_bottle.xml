<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="28dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@color/card_background"
    tools:context=".SpinBottleActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Spin the Bottle"
                android:textSize="22sp"
                android:textColor="@color/text_primary"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btn_close"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="@color/text_secondary"
                android:contentDescription="Close"/>
        </LinearLayout>

        <!-- Bottle Display -->
        <ImageView
            android:id="@+id/iv_bottle"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:src="@drawable/ic_bottle_monotone"
            android:tint="@color/text_primary"
            android:contentDescription="Spin Bottle"
            android:layout_marginBottom="24dp"/>

        <!-- Direction Display -->
        <TextView
            android:id="@+id/tv_direction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tap Spin to start!"
            android:textSize="20sp"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:layout_marginBottom="24dp"/>

        <!-- Spin Button -->
        <Button
            android:id="@+id/btn_spin"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="🔄  SPIN"
            android:textColor="@color/qr_action_button_text"
            android:backgroundTint="@color/qr_action_button_bg"
            app:cornerRadius="28dp"/>

    </LinearLayout>

</androidx.cardview.widget.CardView>
