<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="28dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@color/card_background"
    tools:context=".RollDiceActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Roll Dice"
                android:textSize="22sp"
                android:textColor="@color/text_primary"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btn_close"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="@color/text_secondary"
                android:contentDescription="Close"/>
        </LinearLayout>

        <!-- Dice Count Selector -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dice: "
                android:textSize="16sp"
                android:textColor="@color/text_secondary"
                android:layout_marginEnd="12dp"/>

            <TextView
                android:id="@+id/btn_dice_count_1"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="1"
                android:textSize="18sp"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:gravity="center"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:id="@+id/btn_dice_count_2"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="2"
                android:textSize="18sp"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:gravity="center"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:id="@+id/btn_dice_count_3"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="3"
                android:textSize="18sp"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:gravity="center"
                android:background="?attr/selectableItemBackgroundBorderless"/>
        </LinearLayout>

        <!-- Dice Display Area -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="16dp">

            <!-- Dice 1 (always visible) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginEnd="16dp">
                <TextView
                    android:id="@+id/tv_dice_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚀"
                    android:textSize="72sp"/>
            </LinearLayout>

            <!-- Dice 2 -->
            <LinearLayout
                android:id="@+id/dice_2_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginEnd="16dp"
                android:visibility="gone">
                <TextView
                    android:id="@+id/tv_dice_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚀"
                    android:textSize="72sp"/>
            </LinearLayout>

            <!-- Dice 3 -->
            <LinearLayout
                android:id="@+id/dice_3_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone">
                <TextView
                    android:id="@+id/tv_dice_3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚀"
                    android:textSize="72sp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Total -->
        <TextView
            android:id="@+id/tv_total"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Total: –"
            android:textSize="20sp"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:layout_marginBottom="20dp"/>

        <!-- Roll Button -->
        <Button
            android:id="@+id/btn_roll"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="🎲  ROLL"
            android:textColor="@color/qr_action_button_text"
            android:backgroundTint="@color/qr_action_button_bg"
            app:cornerRadius="28dp"/>

    </LinearLayout>

</androidx.cardview.widget.CardView>
