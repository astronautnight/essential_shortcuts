<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="28dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@color/card_background"
    tools:context=".BlendColorsActivity">

    <com.essential.shortcuts.ObservableScrollView
        android:layout_width="match_parent"
        android:layout_height="600dp">
        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Blend Colors"
                android:textColor="@color/text_primary"
                android:textSize="24sp"
                android:textStyle="bold"
                android:gravity="center_horizontal"
                android:layout_marginBottom="24dp"/>

            <!-- Result Swatch -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="120dp"
                app:cardCornerRadius="16dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/calc_divider"
                android:layout_marginBottom="24dp">
                <View
                    android:id="@+id/view_blend_result"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#000000" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Color Inputs (Min 2, Max 5)"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="16dp"/>

            <!-- Dynamic Color Rows Container -->
            <LinearLayout 
                android:id="@+id/container_colors" 
                android:layout_width="match_parent" 
                android:layout_height="wrap_content" 
                android:orientation="vertical" />
            
            <Button
                android:id="@+id/btn_add_color"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="+ Add Another Color"
                android:textColor="@color/text_primary"
                app:strokeColor="@color/text_secondary"
                app:cornerRadius="28dp"
                android:layout_marginBottom="24dp" />

            <!-- Output Results -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false">
                
                <!-- HEX Result -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Blended HEX"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary"/>
                        
                    <TextView
                        android:id="@+id/tv_hex_code"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="#000000"
                        android:textSize="18sp"
                        android:fontFamily="monospace"
                        android:textColor="@color/text_primary"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="8dp"/>
                        
                    <Button
                        android:id="@+id/btn_copy_hex"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Copy HEX"
                        android:textColor="@color/text_primary"
                        app:strokeColor="@color/text_secondary"
                        android:layout_marginEnd="8dp"/>
                </LinearLayout>

                <!-- RGB Result -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Blended RGB"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary"/>
                        
                    <TextView
                        android:id="@+id/tv_rgb_code"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="rgb(0, 0, 0)"
                        android:textSize="18sp"
                        android:fontFamily="monospace"
                        android:textColor="@color/text_primary"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="8dp"/>
                        
                    <Button
                        android:id="@+id/btn_copy_rgb"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Copy RGB"
                        android:textColor="@color/text_primary"
                        app:strokeColor="@color/text_secondary"
                        android:layout_marginStart="8dp"/>
                </LinearLayout>
            </LinearLayout>

            <Button
                android:id="@+id/btn_close"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:text="Close"
                android:textColor="@color/text_secondary"/>

        </LinearLayout>
    </com.essential.shortcuts.ObservableScrollView>
</androidx.cardview.widget.CardView>
