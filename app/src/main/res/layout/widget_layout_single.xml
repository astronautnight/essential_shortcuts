<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container_single"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="4dp">

    <!-- Single tool tile -->
    <FrameLayout
        android:id="@+id/widget_tool_1"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_gradient_essential"
        android:clickable="true"
        android:padding="12dp">

        <ImageView
            android:id="@+id/widget_icon_1"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="top|start"
            android:src="@android:drawable/ic_menu_edit"
            android:contentDescription="Tool icon" />

        <TextView
            android:id="@+id/widget_name_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:text="Tool"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end" />
    </FrameLayout>
</FrameLayout>
