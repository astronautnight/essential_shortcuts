<?xml version="1.0" encoding="utf-8"?>
<com.essential.shortcuts.ObservableScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    tools:context=".LaptopFramesActivity">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="28dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/card_background">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Laptop Frames"
                    android:textSize="22sp"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btn_close"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    app:tint="@color/text_secondary"
                    android:contentDescription="Close" />
            </LinearLayout>

            <!-- Pick Screenshot Button -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_pick_image"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="@color/pwd_result_bg"
                app:strokeWidth="1dp"
                app:strokeColor="@color/text_secondary"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:id="@+id/layout_pick_placeholder"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@android:drawable/ic_menu_gallery"
                        app:tint="@color/text_secondary"
                        android:contentDescription="Pick screenshot" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tap to select a screenshot"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp"
                        android:layout_marginTop="8dp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/iv_preview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerInside"
                    android:visibility="gone"
                    android:contentDescription="Screenshot preview" />
                    
                <VideoView
                    android:id="@+id/vv_preview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:visibility="gone" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Laptop Model Selection -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Laptop Frame Model"
                    android:textSize="15sp"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Windows Option -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_model_windows"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        app:cardCornerRadius="12dp"
                        app:cardBackgroundColor="@color/pwd_result_bg"
                        app:strokeWidth="1dp"
                        app:strokeColor="@color/text_secondary"
                        android:clickable="true"
                        android:focusable="true">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp"
                            android:gravity="center">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Windows"
                                android:textSize="15sp"
                                android:textColor="@color/text_primary"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- macOS Option -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_model_macos"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        app:cardCornerRadius="12dp"
                        app:cardBackgroundColor="@color/pwd_result_bg"
                        app:strokeWidth="2dp"
                        app:strokeColor="@color/category_essential"
                        android:clickable="true"
                        android:focusable="true">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp"
                            android:gravity="center">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="macOS"
                                android:textSize="15sp"
                                android:textColor="@color/text_primary"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </LinearLayout>

            <!-- Background Color Section -->
            <LinearLayout
                android:id="@+id/layout_color_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Background Color"
                    android:textSize="15sp"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <!-- Preset color chips -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginBottom="12dp">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/chip_color_1"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        app:cardCornerRadius="20dp"
                        app:cardBackgroundColor="#FFFFFF"
                        app:strokeWidth="2dp"
                        app:strokeColor="@color/text_secondary"
                        android:layout_marginEnd="8dp"
                        android:clickable="true"
                        android:focusable="true" />

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/chip_color_2"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        app:cardCornerRadius="20dp"
                        app:cardBackgroundColor="#000000"
                        app:strokeWidth="2dp"
                        app:strokeColor="@android:color/transparent"
                        android:layout_marginEnd="8dp"
                        android:clickable="true"
                        android:focusable="true" />

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/chip_color_3"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        app:cardCornerRadius="20dp"
                        app:cardBackgroundColor="#E8F5E9"
                        app:strokeWidth="2dp"
                        app:strokeColor="@android:color/transparent"
                        android:layout_marginEnd="8dp"
                        android:clickable="true"
                        android:focusable="true" />

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/chip_color_4"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        app:cardCornerRadius="20dp"
                        app:cardBackgroundColor="#E3F2FD"
                        app:strokeWidth="2dp"
                        app:strokeColor="@android:color/transparent"
                        android:layout_marginEnd="8dp"
                        android:clickable="true"
                        android:focusable="true" />

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/chip_color_5"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        app:cardCornerRadius="20dp"
                        app:cardBackgroundColor="#FFF3E0"
                        app:strokeWidth="2dp"
                        app:strokeColor="@android:color/transparent"
                        android:layout_marginEnd="8dp"
                        android:clickable="true"
                        android:focusable="true" />

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/chip_color_6"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        app:cardCornerRadius="20dp"
                        app:cardBackgroundColor="#F3E5F5"
                        app:strokeWidth="2dp"
                        app:strokeColor="@android:color/transparent"
                        android:layout_marginEnd="8dp"
                        android:clickable="true"
                        android:focusable="true" />

                    <!-- Custom color picker button -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/chip_color_custom"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        app:cardCornerRadius="20dp"
                        app:cardBackgroundColor="@color/pwd_result_bg"
                        app:strokeWidth="1dp"
                        app:strokeColor="@color/text_secondary"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_color_picker"
                            app:tint="@color/text_secondary"
                            android:contentDescription="Custom color" />
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <!-- Hex color input -->
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Hex Color (e.g. #FF5722)"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusBottomEnd="12dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_hex_color"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:maxLength="9"
                        android:text="#FFFFFF" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- Frame Padding Section -->
            <LinearLayout
                android:id="@+id/layout_padding_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Frame Padding"
                        android:textSize="15sp"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_padding_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="40%"
                        android:textSize="14sp"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/seekbar_padding"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:min="5"
                    android:max="80"
                    android:progress="40"
                    android:progressTint="@color/category_essential"
                    android:thumbTint="@color/category_essential" />
            </LinearLayout>

            <!-- Quality Option for Video -->
            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cb_full_quality"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Full Quality (Original resolution &amp; frame rate)"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                app:buttonTint="@color/category_essential"
                android:visibility="gone"
                android:layout_marginBottom="16dp" />

            <!-- Generate Button -->
            <Button
                android:id="@+id/btn_generate"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Generate Frame"
                android:textColor="@color/qr_action_button_text"
                android:backgroundTint="@color/qr_action_button_bg"
                app:cornerRadius="28dp"
                android:visibility="gone" />

            <!-- Result Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_result"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="@color/pwd_result_bg"
                app:strokeWidth="0dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Framed Screenshot"
                        android:textSize="13sp"
                        android:textColor="@color/text_secondary"
                        android:layout_marginBottom="8dp" />

                    <ImageView
                        android:id="@+id/iv_result"
                        android:layout_width="match_parent"
                        android:layout_height="300dp"
                        android:scaleType="centerInside"
                        android:layout_marginBottom="12dp"
                        android:contentDescription="Framed screenshot result" />
                        
                    <VideoView
                        android:id="@+id/vv_result"
                        android:layout_width="match_parent"
                        android:layout_height="300dp"
                        android:layout_gravity="center"
                        android:layout_marginBottom="12dp"
                        android:visibility="gone" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <Button
                            android:id="@+id/btn_save"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Save"
                            android:textColor="@color/text_primary"
                            app:strokeColor="@color/text_secondary"
                            android:layout_marginEnd="8dp" />

                        <Button
                            android:id="@+id/btn_share"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Share"
                            android:textColor="@color/qr_action_button_text"
                            android:backgroundTint="@color/qr_action_button_bg"
                            android:layout_marginStart="8dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- Progress Overlay for Video Processing -->
        <FrameLayout
            android:id="@+id/layout_progress"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#80000000"
            android:visibility="gone"
            android:elevation="10dp"
            android:clickable="true"
            android:focusable="true">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_gravity="center"
                android:background="@drawable/bg_settings_premium"
                android:padding="24dp"
                android:gravity="center">
                <com.essential.shortcuts.ProgressTickView
                    android:id="@+id/progress_tick"
                    android:layout_width="64dp"
                    android:layout_height="64dp" />
                <TextView
                    android:id="@+id/tv_progress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Processing Video..."
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>
    </androidx.cardview.widget.CardView>

</com.essential.shortcuts.ObservableScrollView>
