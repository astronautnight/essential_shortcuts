<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_tool"
    android:layout_width="176dp"
    android:layout_height="121dp"
    android:layout_margin="6dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="2dp"
    android:clickable="true"
    android:focusable="true">

    <!-- FrameLayout so ProgressTickView can overlay on top of card content -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp">

            <!-- Icon (top-left) -->
            <ImageView
                android:id="@+id/iv_tool_icon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@android:drawable/ic_menu_edit"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Tool Name (bottom) -->
            <TextView
                android:id="@+id/tv_tool_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Tool Name"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Progress tick overlay — top-right corner, hidden until tapped -->
        <com.essential.shortcuts.ProgressTickView
            android:id="@+id/progress_tick"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_gravity="top|end"
            android:layout_margin="6dp"
            android:visibility="gone" />

    </FrameLayout>

</com.google.android.material.card.MaterialCardView>
