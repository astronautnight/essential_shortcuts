<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/settings_row_bg"
    android:padding="14dp"
    android:layout_marginBottom="8dp">

    <!-- Template name -->
    <TextView
        android:id="@+id/tv_template_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="2dp"/>

    <!-- Subject preview -->
    <TextView
        android:id="@+id/tv_template_subject"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textColor="@color/text_secondary"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_marginBottom="10dp"/>

    <!-- Action buttons row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Use -->
        <Button
            android:id="@+id/btn_template_use"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="Use"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="@color/primary_orange"
            app:cornerRadius="18dp"
            android:layout_marginEnd="6dp"/>

        <!-- Rename -->
        <ImageView
            android:id="@+id/btn_template_rename"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="8dp"
            android:src="@drawable/ic_edit"
            app:tint="@color/text_secondary"
            android:contentDescription="Rename"
            android:background="@drawable/bg_circle_dark"
            android:layout_marginEnd="6dp"/>

        <!-- Delete -->
        <ImageView
            android:id="@+id/btn_template_delete"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="8dp"
            android:src="@drawable/ic_delete"
            app:tint="@color/text_secondary"
            android:contentDescription="Delete"
            android:background="@drawable/bg_circle_dark"/>

    </LinearLayout>
</LinearLayout>
