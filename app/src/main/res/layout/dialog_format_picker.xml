<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="24dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@color/share_dialog_bg"
    app:strokeWidth="0dp"
    android:layout_margin="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Subtitle/Question outside the inner card -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select target format"
            android:textSize="20sp"
            android:textColor="@color/share_dialog_text"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="12dp"
            android:layout_marginStart="4dp" />

        <!-- Inner card containing options -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/share_dialog_inner_bg"
            app:strokeWidth="0dp">

            <LinearLayout
                android:id="@+id/options_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <!-- Option: JPG -->
                <TextView
                    android:id="@+id/btn_format_jpg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Convert to JPG"
                    android:textColor="@color/share_dialog_text"
                    android:textSize="17sp"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:background="@color/share_dialog_divider" />

                <!-- Option: PNG -->
                <TextView
                    android:id="@+id/btn_format_png"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Convert to PNG"
                    android:textColor="@color/share_dialog_text"
                    android:textSize="17sp"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:background="@color/share_dialog_divider" />

                <!-- Option: WebP -->
                <TextView
                    android:id="@+id/btn_format_webp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Convert to WebP"
                    android:textColor="@color/share_dialog_text"
                    android:textSize="17sp"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:background="@color/share_dialog_divider" />

                <!-- Option: PDF -->
                <TextView
                    android:id="@+id/btn_format_pdf"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Compile to PDF"
                    android:textColor="@color/share_dialog_text"
                    android:textSize="17sp"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
