<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:scrollbars="none">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/share_dialog_bg"
        app:strokeWidth="0dp"
        android:layout_margin="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Title / Question outside the inner card -->
            <TextView
                android:id="@+id/tv_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Convert Image"
                android:textSize="20sp"
                android:textColor="@color/share_dialog_text"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="12dp"
                android:layout_marginStart="4dp" />

            <!-- Inner card container -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/share_dialog_inner_bg"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- STATE 1: Pick Images Placeholder (only visible when no images are selected) -->
                    <LinearLayout
                        android:id="@+id/layout_pick_placeholder"
                        android:layout_width="match_parent"
                        android:layout_height="140dp"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:background="?android:attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true">
                        
                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@android:drawable/ic_menu_gallery"
                            app:tint="@color/share_dialog_subtext"
                            android:contentDescription="Gallery Icon"/>
                            
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tap to select image(s)"
                            android:textColor="@color/share_dialog_text"
                            android:textSize="15sp"
                            android:layout_marginTop="8dp" />
                    </LinearLayout>

                    <!-- STATE 2: Format Selector (visible when images are ready to convert) -->
                    <LinearLayout
                        android:id="@+id/layout_format_picker"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/btn_format_jpg"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Convert to JPG"
                            android:textColor="@color/share_dialog_text"
                            android:textSize="17sp"
                            android:paddingTop="16dp"
                            android:paddingBottom="16dp"
                            android:background="?android:attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="0.5dp"
                            android:background="@color/share_dialog_divider" />

                        <TextView
                            android:id="@+id/btn_format_png"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Convert to PNG"
                            android:textColor="@color/share_dialog_text"
                            android:textSize="17sp"
                            android:paddingTop="16dp"
                            android:paddingBottom="16dp"
                            android:background="?android:attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="0.5dp"
                            android:background="@color/share_dialog_divider" />

                        <TextView
                            android:id="@+id/btn_format_webp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Convert to WebP"
                            android:textColor="@color/share_dialog_text"
                            android:textSize="17sp"
                            android:paddingTop="16dp"
                            android:paddingBottom="16dp"
                            android:background="?android:attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="0.5dp"
                            android:background="@color/share_dialog_divider" />

                        <TextView
                            android:id="@+id/btn_format_pdf"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Compile to PDF"
                            android:textColor="@color/share_dialog_text"
                            android:textSize="17sp"
                            android:paddingTop="16dp"
                            android:paddingBottom="16dp"
                            android:background="?android:attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true" />
                    </LinearLayout>

                    <!-- STATE 3: Converting/Loading (visible during processing) -->
                    <LinearLayout
                        android:id="@+id/layout_converting"
                        android:layout_width="match_parent"
                        android:layout_height="140dp"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="20dp"
                        android:visibility="gone">

                        <ProgressBar
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:indeterminateTint="@color/share_dialog_text" />

                        <TextView
                            android:id="@+id/tv_converting_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Converting images..."
                            android:textColor="@color/share_dialog_text"
                            android:textSize="15sp"
                            android:layout_marginTop="12dp" />
                    </LinearLayout>

                    <!-- STATE 4: Conversion Result (visible on success) -->
                    <LinearLayout
                        android:id="@+id/layout_result"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp"
                        android:gravity="center"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@android:drawable/checkbox_on_background"
                            app:tint="@color/share_dialog_text"
                            android:layout_marginBottom="12dp"
                            android:contentDescription="Success Icon"/>

                        <TextView
                            android:id="@+id/tv_converted_info"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/share_dialog_text"
                            android:gravity="center"
                            android:layout_marginBottom="4dp"/>

                        <TextView
                            android:id="@+id/tv_saved_space"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="13sp"
                            android:textColor="@color/share_dialog_subtext"
                            android:gravity="center"
                            android:layout_marginBottom="20dp"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center">

                            <Button
                                android:id="@+id/btn_save"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_weight="1"
                                android:text="Save All"
                                android:textColor="@color/share_dialog_text"
                                app:strokeColor="@color/share_dialog_divider"
                                android:layout_marginEnd="8dp"/>

                            <Button
                                android:id="@+id/btn_share"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_weight="1"
                                android:text="Share All"
                                android:textColor="@color/share_dialog_inner_bg"
                                android:backgroundTint="@color/share_dialog_text"
                                android:layout_marginStart="8dp"/>
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</ScrollView>
