<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <ScrollView
        android:id="@+id/dialog_scroll_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_gravity="top|center_horizontal">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/share_dialog_bg"
            app:strokeWidth="0dp"
            android:layout_margin="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Title / Step Header -->
                <TextView
                    android:id="@+id/tv_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Meme Generator"
                    android:textSize="20sp"
                    android:textColor="@color/share_dialog_text"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="12dp"
                    android:layout_marginStart="4dp" />

                <!-- Inner Card Container -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/share_dialog_inner_bg"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- STATE 1: Pick Image Placeholder -->
                        <LinearLayout
                            android:id="@+id/layout_pick_placeholder"
                            android:layout_width="match_parent"
                            android:layout_height="140dp"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="16dp"
                            android:background="?android:attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:visibility="visible">
                            
                            <ImageView
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:src="@android:drawable/ic_menu_gallery"
                                app:tint="@color/share_dialog_subtext"
                                android:contentDescription="Gallery Icon"/>
                                
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Tap to select template image"
                                android:textColor="@color/share_dialog_text"
                                android:textSize="15sp"
                                android:layout_marginTop="8dp" />
                        </LinearLayout>

                        <!-- STATE 2: Lines Selector Dropdown -->
                        <LinearLayout
                            android:id="@+id/layout_lines_picker"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:visibility="gone">

                            <TextView
                                android:id="@+id/btn_lines_1_top"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="1 Line (Top)"
                                android:textColor="@color/share_dialog_text"
                                android:textSize="17sp"
                                android:paddingTop="16dp"
                                android:paddingBottom="16dp"
                                android:background="?android:attr/selectableItemBackground"
                                android:clickable="true"
                                android:focusable="true" />

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="0.5dp"
                                android:background="@color/share_dialog_divider" />

                            <TextView
                                android:id="@+id/btn_lines_1_bottom"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="1 Line (Bottom)"
                                android:textColor="@color/share_dialog_text"
                                android:textSize="17sp"
                                android:paddingTop="16dp"
                                android:paddingBottom="16dp"
                                android:background="?android:attr/selectableItemBackground"
                                android:clickable="true"
                                android:focusable="true" />

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="0.5dp"
                                android:background="@color/share_dialog_divider" />

                            <TextView
                                android:id="@+id/btn_lines_2"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="2 Lines (Top &amp; Bottom)"
                                android:textColor="@color/share_dialog_text"
                                android:textSize="17sp"
                                android:paddingTop="16dp"
                                android:paddingBottom="16dp"
                                android:background="?android:attr/selectableItemBackground"
                                android:clickable="true"
                                android:focusable="true" />
                        </LinearLayout>

                        <!-- STATE 3: Text Input Fields -->
                        <LinearLayout
                            android:id="@+id/layout_text_inputs"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="20dp"
                            android:visibility="gone">

                            <EditText
                                android:id="@+id/et_top_text"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Top Text"
                                android:inputType="textCapCharacters"
                                android:textColor="@color/share_dialog_text"
                                android:textColorHint="@color/share_dialog_subtext"
                                android:layout_marginBottom="12dp"
                                android:padding="12dp"
                                android:background="@android:drawable/editbox_background_normal" />

                            <EditText
                                android:id="@+id/et_bottom_text"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Bottom Text"
                                android:inputType="textCapCharacters"
                                android:textColor="@color/share_dialog_text"
                                android:textColorHint="@color/share_dialog_subtext"
                                android:layout_marginBottom="20dp"
                                android:padding="12dp"
                                android:background="@android:drawable/editbox_background_normal" />

                            <Button
                                android:id="@+id/btn_generate_meme"
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:text="Generate Meme"
                                android:textColor="@color/share_dialog_inner_bg"
                                android:backgroundTint="@color/share_dialog_text" />
                        </LinearLayout>

                        <!-- STATE 4: Generating Indicator -->
                        <LinearLayout
                            android:id="@+id/layout_generating"
                            android:layout_width="match_parent"
                            android:layout_height="140dp"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="20dp"
                            android:visibility="gone">

                            <ProgressBar
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:indeterminateTint="@color/share_dialog_text" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Generating meme..."
                                android:textColor="@color/share_dialog_text"
                                android:textSize="15sp"
                                android:layout_marginTop="12dp" />
                        </LinearLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </ScrollView>

    <!-- STATE 5: iOS-Style Quick Look Fullscreen Overlay -->
    <RelativeLayout
        android:id="@+id/layout_quick_look"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#1C1C1E"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <!-- Top Header Bar -->
        <RelativeLayout
            android:id="@+id/quick_look_header"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_alignParentTop="true"
            android:background="#2C2C2E"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:id="@+id/btn_quick_look_done"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_alignParentEnd="true"
                android:gravity="center"
                android:text="Done"
                android:textColor="#0A84FF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_centerInParent="true"
                android:gravity="center"
                android:text="Meme.png"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- Main Image Area -->
        <ImageView
            android:id="@+id/iv_meme_preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@+id/quick_look_footer"
            android:layout_below="@+id/quick_look_header"
            android:padding="16dp"
            android:scaleType="fitCenter"
            android:contentDescription="Meme Preview" />

        <!-- Bottom Actions Bar -->
        <LinearLayout
            android:id="@+id/quick_look_footer"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_alignParentBottom="true"
            android:background="#2C2C2E"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">

            <ImageView
                android:id="@+id/btn_quick_look_share"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_share_ios"
                app:tint="#0A84FF"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Share Button" />

            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/btn_quick_look_save"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_save_ios"
                app:tint="#0A84FF"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Save Button" />
        </LinearLayout>
    </RelativeLayout>

</FrameLayout>
